{
  "name": "lingxi",
  "version": "0.3.3",
  "description": "Lingxi sidebar AI image generation for Obsidian notes.",
  "main": "main.js",
  "scripts": {
    "version-sync": "node version-bump.mjs",
    "dev": "npm run version-sync && node esbuild.config.mjs",
    "build": "npm run version-sync && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/**/*.test.ts",
    "version": "npm run version-sync && git add manifest.json versions.json",
    "deploy:dev": "bash scripts/deploy-dev.sh"
  },
  "keywords": [
    "obsidian",
    "canvas",
    "ai",
    "gemini"
  ],
  "author": "Zane",
  "license": "MIT",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/eslintrc": "^3.3.3",
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "eslint": "^9.39.2",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.9.3"
  }
}
